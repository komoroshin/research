{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/progress/**",
              "components/typography/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Oswald|Inter))/i]",
        "message": "Font not provided by the design system. Available: Oswald, Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActionLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|dark|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ActionLink> doesn't accept that prop. Declared props: children, dark, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|strong|as|style|key|ref|className|style|children)$/]",
        "message": "<BodyText> doesn't accept that prop. Declared props: children, tone, size, strong, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BodyText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|soft|dark|muted|paper)$/]",
        "message": "<BodyText> tone must be one of 'default' | 'soft' | 'dark' | 'muted' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|ghost|cream)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'ghost' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|tight|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, variant, tight, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|quiet|accent|dark|lift|line)$/]",
        "message": "<Card> variant must be one of 'default' | 'quiet' | 'accent' | 'dark' | 'lift' | 'line'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|sage)$/]",
        "message": "<Chip> tone must be one of 'cream' | 'sage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DayDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:pattern|style|key|ref|className|style|children)$/]",
        "message": "<DayDots> doesn't accept that prop. Declared props: pattern, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|weight|dark|as|style|key|ref|className|style|children)$/]",
        "message": "<Display> doesn't accept that prop. Declared props: children, size, weight, dark, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Display'] > JSXAttribute[name.name='weight'] > Literal[value!=/^(?:primary|secondary)$/]",
        "message": "<Display> weight must be one of 'primary' | 'secondary'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|tight|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, tone, tight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|soft|dark|forest)$/]",
        "message": "<Eyebrow> tone must be one of 'default' | 'soft' | 'dark' | 'forest'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|action|tone|style|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: label, children, action, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|alert)$/]",
        "message": "<Notice> tone must be one of 'quiet' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Numeral'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|unit|size|dark|style|key|ref|className|style|children)$/]",
        "message": "<Numeral> doesn't accept that prop. Declared props: children, unit, size, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|state|children|last|style|key|ref|className|style|children)$/]",
        "message": "<PathNode> doesn't accept that prop. Declared props: title, meta, state, children, last, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PathNode'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:done|current|ahead)$/]",
        "message": "<PathNode> state must be one of 'done' | 'current' | 'ahead'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PhotoTile> doesn't accept that prop. Declared props: label, sub, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|dark|style|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, dark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:dark|width|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: dark, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScaleSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|value|max|labels|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ScaleSlider> doesn't accept that prop. Declared props: label, sub, value, max, labels, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScaleStepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|sub|value|labels|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ScaleStepper> doesn't accept that prop. Declared props: label, sub, value, labels, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StoolPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|types|label|sub|keyline|onChange|style|key|ref|className|style|children)$/]",
        "message": "<StoolPicker> doesn't accept that prop. Declared props: value, types, label, sub, keyline, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: tabs, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|show|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, show, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
