# Скопируйте в .env и заполните. .env в git не попадает.
TELEGRAM_BOT_TOKEN=
# Кто может пользоваться ботом: Telegram user id через запятую. Пусто = все (только для теста!)
ALLOWED_USER_IDS=

ANTHROPIC_API_KEY=
# Модель для разбора выезда. claude-sonnet-5 дешевле, claude-opus-5 точнее.
CLAUDE_MODEL=claude-opus-5

# Расшифровка речи: openai | sidecar (тест: читает .txt рядом с файлом)
STT_PROVIDER=openai
OPENAI_API_KEY=
STT_MODEL=gpt-4o-transcribe

# Разбор выезда: claude | stub (тест: берёт готовый JSON из samples/)
EXTRACTOR=claude

# Кадров из одного видео и фото всего в одном запросе к Claude
FRAMES_PER_VIDEO=12
MAX_IMAGES=20
DATA_DIR=./data
